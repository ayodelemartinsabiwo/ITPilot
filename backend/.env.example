# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=core.settings

# Database
DATABASE_URL=postgresql://itpilot_user:itpilot_password@localhost:5432/itpilot_db
DB_NAME=itpilot_db
DB_USER=itpilot_user
DB_PASSWORD=itpilot_password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Security
AES_ENCRYPTION_KEY=your-32-byte-encryption-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_LIFETIME=15  # minutes
JWT_REFRESH_TOKEN_LIFETIME=7  # days

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# OpenAI (for AI Chatbot)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2000

# Payment Gateways
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key

FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-flutterwave-public-key
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your-flutterwave-secret-key

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=ITPilot <noreply@itpilot.com>

# AWS S3 (Optional - for file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=itpilot-storage
AWS_S3_REGION_NAME=us-east-1

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn

# Rate Limiting
RATE_LIMIT_ENABLED=True
DEFAULT_RATE_LIMIT=100/hour

# Session Settings
SESSION_COOKIE_AGE=86400  # 24 hours
SESSION_TIMEOUT_WARNING=300  # 5 minutes

# WebSocket
WEBSOCKET_ACCEPT_ALL=False
WEBSOCKET_ORIGIN_WHITELIST=localhost:3000,localhost:8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/itpilot.log

# Celery Beat
CELERY_BEAT_SCHEDULER=django_celery_beat.schedulers:DatabaseScheduler

# Multi-tenancy
DEFAULT_SCHEMA=public
TENANT_MODEL=organizations.Organization
TENANT_DOMAIN_MODEL=organizations.Domain

# Feature Flags
FEATURE_AI_CHATBOT=True
FEATURE_REMOTE_ACCESS=True
FEATURE_MICROSOFT_INTEGRATION=True
FEATURE_GOOGLE_INTEGRATION=True
FEATURE_DEVICE_MONITORING=True

# Remote Access
REMOTE_SESSION_TIMEOUT=3600  # 1 hour
REMOTE_SESSION_MAX_DURATION=14400  # 4 hours
REMOTE_SESSION_RECORDING_ENABLED=True

# Device Agent
DEVICE_AGENT_VERSION=1.0.0
DEVICE_HEALTH_CHECK_INTERVAL=300  # 5 minutes

# Compliance
AUDIT_LOG_RETENTION_DAYS=365
SESSION_LOG_RETENTION_DAYS=730
GDPR_ENABLED=True
NDPR_ENABLED=True
